execute_process(COMMAND "${PROGRAM}" --fixtures OUTPUT_VARIABLE actual RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Fixture encoder failed")
endif()
file(READ "${FIXTURE}" expected)
string(STRIP "${actual}" actual)
string(STRIP "${expected}" expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Production C wire encoding differs from the firmware fixture")
endif()
if(DEFINED HOST_FIXTURE AND EXISTS "${HOST_FIXTURE}")
  file(READ "${HOST_FIXTURE}" host_expected)
  string(STRIP "${host_expected}" host_expected)
  if(NOT expected STREQUAL host_expected)
    message(FATAL_ERROR "Firmware and HostApp wire fixtures differ")
  endif()
endif()
